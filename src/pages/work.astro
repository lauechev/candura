---
import BaseLayout from '@/layouts/BaseLayout.astro';
// Aliased: Astro names a page's own component after its file, so a plain
// `Work` import collides with work.astro's generated local declaration.
import WorkCard from '@/components/Work.astro';

const bienvenides = '/bienvenides.png';
const sanarte = '/sanarte.png';
const type = '/type-checker.png';
const news = '/newsletter.png';
const ebook2 = '/ebook2.png';
const art = '/art.png';
const ux = '/ux.png';
---

<BaseLayout title="Work" pageHeading="Work" description="Selected projects by Candura.">
  <main class="container">
    <div class="grid">
      <WorkCard brand="Brand name" services={['Shopify Store Development']} images={[sanarte]} />
      <WorkCard brand="Brand name" services={['History of the Internet Website']} images={[ux]} />
      <WorkCard brand="Brand name" services={['Typeface Checker Website']} images={[type]} />
      <WorkCard brand="Brand name" services={['Digital Art Collection Website']} images={[art]} />
      <WorkCard brand="Brand name" services={['Newsletter Visual Universe']} images={[news]} />
      <WorkCard brand="Brand name" services={['Ebook Creative Direction & Design']} images={[ebook2]} />
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  // No top padding: the grid sits directly under .page-header-global's own
  // 3rem bottom padding (BaseLayout), so the cards start as high as the
  // header spacer allows.
  main {
    padding-top: 0;
    padding-bottom: 6rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
    }
  }
</style>
