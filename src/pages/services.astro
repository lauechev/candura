---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Service from '@/components/Service.astro';
import { programCategories, serviceCategories } from '@/data/services';
---

<BaseLayout pageHeading="Services" title="Services" description="what we do">
  <main>
    <div class="pillars">
      <p class="group-label">(services)</p>
      {serviceCategories.en.map((category) => <Service title={category.title} items={category.items} />)}
    </div>
    <div class="programs">
      <p class="group-label">(programs)</p>
      <p class="programs-intro">* all of our programs are customizable</p>
      {programCategories.en.map((program) => <Service title={program.title} items={program.items} align="right" />)}
    </div>

    <img class="cat cat--top" src="/cat2.jpg" alt="" />
    <img class="cat cat--bottom" src="/cat2.jpg" alt="" />
  </main>
</BaseLayout>

<script>
  import { attachConfettiPop } from '@/scripts/confetti';

  attachConfettiPop('.cat');
</script>

<style lang="scss">
  main {
    // 100% of .page-content, which already excludes the corner nav's
    // reserved column — leaves the same 2.5rem side gutters as TextBlock.astro.
    width: calc(100% - 5rem);
    margin-inline: auto;
    padding-top: 10rem;
    padding-bottom: 20rem;
    // Keeps the footer off the fold if the page is ever short (the empty page
    // header above is 10rem tall); inert once the content runs longer.
    min-height: calc(100vh - 10rem);
    min-height: calc(100svh - 10rem);
    // Anchors .cat.
    position: relative;
  }

  // Sits in the empty upper-right gap between the services index and the
  // corner nav, starting a bit above both.
  .cat {
    position: absolute;
    top: 0;
    right: 6%;
    width: clamp(7rem, 9vw, 10.5rem);
    height: auto;
    // Clicking it bursts the piñata's confetti (see @/scripts/confetti).
    cursor: pointer;
    transition: transform 150ms ease;

    &.is-popping {
      transform: scale(0.88);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat {
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    // The page header above shrinks here and there's no side nav — content
    // can sit much closer to the top.
    main {
      padding-top: 2rem;
    }

    // The side gap is gone once the nav collapses and the list goes full
    // width, so the cat drops into the flow above the list instead.
    .cat {
      position: static;
      display: block;
      width: 6rem;
      margin: 5rem auto 0;
    }
  }

  .pillars {
    display: flex;
    flex-direction: column;
    // A quiet index doesn't need the full line length; nudged off the left
    // gutter toward the center of the available space.
    width: 48%;
    margin-left: 10%;
  }

  @media (max-width: 1024px) {
    .pillars {
      width: 100%;
      margin-left: 0;
    }
  }

  // The mirror of .pillars: same width, anchored to the right edge instead,
  // with everything inside reading flush right.
  .programs {
    display: flex;
    flex-direction: column;
    width: 48%;
    margin-left: auto;
    margin-right: 10%;
    // Enough air that the two groups read as separate sections.
    margin-top: 9rem;
    text-align: right;
  }

  // Small green label naming each group.
  .group-label {
    font-family: var(--font-body);
    font-weight: var(--font-weight-display);
    font-size: 1.8rem;
    color: var(--green);
    margin: 0 0 1.5rem;
  }

  .programs-intro {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--black);
    margin: 0 0 2rem;
  }

  @media (max-width: 1024px) {
    .programs {
      width: 100%;
      margin-right: 0;
      margin-top: 6rem;
    }
  }

  @media (max-width: 768px) {
    main {
      padding-bottom: 8rem;
    }

    .group-label {
      font-size: 1.4rem;
    }
  }
</style>
