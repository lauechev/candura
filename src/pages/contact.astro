---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ImageText from '@/components/ImageText.astro';
---

<BaseLayout pageHeading="Contact" title="Contact" description="Get in touch with Candura.">
  <main>
    <div class="contact-wrapper">
      <ImageText
        color="transparent"
        title="let's talk"
        description={["Have a project in mind? We'd love to hear about it.", 'Email us at:']}
        image="/beeper.png"
        imageSize="70%"
      >
        <a href="mailto:hi@candura.studio" class="email">hi@candura.studio</a>

        <div class="social-links">
          <p class="follow">Follow us on:</p>
          <div class="social-icons">
            <a href="https://www.instagram.com/candura.studio" target="_blank" rel="noopener noreferrer"
              ><img src="/ig.svg" alt="Instagram" /></a
            >
            <a href="https://www.linkedin.com/company/candura-studio/" target="_blank" rel="noopener noreferrer"
              ><img src="/linkedin.svg" alt="LinkedIn" /></a
            >
          </div>
        </div>
      </ImageText>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  main {
    display: flex;
    justify-content: center;
    padding: 2rem 3rem 11.5rem;
  }

  .contact-wrapper {
    width: 65vw;
    margin: 0 auto;

    :global(.about-split) {
      width: 100%;
    }

    :global(.split-text) {
      border-right: none;
      border-left: none;
    }

    :global(.split-image) {
      border-bottom: none;
    }
  }

  .email {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: var(--fw-medium);
    color: var(--black);
    text-decoration: none;
    line-height: var(--lh-heading);

    &:hover {
      opacity: 0.6;
    }
  }

  .social-links {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    // Set to match .email above — it's a label, not running copy.
    .follow {
      font-family: var(--font-display);
      font-size: var(--fs-h5);
      font-weight: var(--fw-medium);
      line-height: var(--lh-heading);
      color: var(--black);
      margin: 0;
    }

    .social-icons {
      display: flex;
      flex-direction: row;
      gap: 1rem;
      align-items: center;
    }

    a {
      text-decoration: none;
      display: inline-block;

      &:hover {
        opacity: 0.6;
      }

      img {
        height: 1.5rem;
        width: auto;
      }
    }
  }

  @media (max-width: 1500px) {
    .contact-wrapper {
      width: 50vw;
    }
  }

  @media (max-width: 768px) {
    main {
      padding-top: 0;
    }

    .contact-wrapper {
      width: 100%;
    }
  }
</style>
