---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Service from '@/components/Service.astro';
import { serviceCategories } from '@/data/services';
---

<BaseLayout
  pageHeading="Servicios"
  title="Servicios"
  description="Lo que ofrece Candura — de la estrategia a la ejecución."
>
  <main>
    <div class="pillars">
      {serviceCategories.es.map((category) => <Service title={category.title} items={category.items} />)}
    </div>
    <img class="cat" src="/cat2.jpg" alt="" />
  </main>
</BaseLayout>

<style lang="scss">
  main {
    // 100% of .page-content, which already excludes the corner nav's
    // reserved column — leaves the same 2.5rem side gutters as Intro.astro.
    width: calc(100% - 5rem);
    margin-inline: auto;
    padding-top: 12rem;
    padding-bottom: 1rem;
    // Bottom edge lands exactly at the fold (the empty page header above is
    // 10rem tall), so the footer sits just below and appears on scroll.
    min-height: calc(100vh - 10rem);
    min-height: calc(100svh - 10rem);
    // Anchors .cat.
    position: relative;
  }

  // Sits in the empty upper-right gap between the services index and the
  // corner nav, starting a bit above both.
  .cat {
    position: absolute;
    top: 0;
    right: 6%;
    width: clamp(7rem, 11vw, 10.5rem);
    // Shorter than the source's 395:594, with the photo pinned to its
    // bottom edge — crops the top portion away.
    aspect-ratio: 8 / 11;
    object-fit: cover;
    object-position: bottom;
  }

  @media (max-width: 1024px) {
    // The page header above shrinks here and there's no side nav — content
    // can sit much closer to the top.
    main {
      padding-top: 2rem;
    }

    // The side gap is gone once the nav collapses and the list goes full
    // width, so the cat drops into the flow above the list instead.
    .cat {
      position: static;
      display: block;
      width: 6rem;
      margin: 5rem auto 0;
    }
  }

  .pillars {
    display: flex;
    flex-direction: column;
    // A quiet index doesn't need the full line length; nudged off the left
    // gutter toward the center of the available space.
    width: 55%;
    margin-left: 10%;
  }

  @media (max-width: 1024px) {
    .pillars {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 768px) {
    main {
      padding-bottom: 8rem;
    }
  }
</style>
