---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Service from '@/components/Service.astro';
import { programCategories, serviceCategories } from '@/data/services';
---

<BaseLayout
  pageHeading="Servicios"
  title="Servicios"
  description="Lo que ofrece Candura — de la estrategia a la ejecución."
>
  <main>
    <div class="pillars">
      <h2 class="group-label">(servicios)</h2>
      {serviceCategories.es.map((category) => <Service title={category.title} items={category.items} />)}
    </div>

    <!-- Each cat follows its own group, which is what stacks them alternately
         on mobile. Both are absolutely positioned above 1024px, so this order
         has no effect on the desktop composition. -->
    <img class="cat cat--top" src="/cat2.jpg" alt="" />

    <div class="programs">
      <h2 class="group-label">(programas)</h2>
      <p class="programs-intro">
        nuestros (programas) combinan algunos servicios que se complementan según las necesidades de cada cliente.
      </p>
      {
        programCategories.es.map((program) => (
          <Service title={program.title} items={program.items} align="right" />
        ))
      }
    </div>

    <img class="cat cat--bottom" src="/controls.jpeg" alt="" />
  </main>
</BaseLayout>

<script>
  import { attachConfettiPop } from '@/scripts/confetti';

  attachConfettiPop('.cat');
</script>

<style lang="scss">
  main {
    // 100% of .page-content, which already excludes the corner nav's
    // reserved column — leaves the same 2.5rem side gutters as TextBlock.astro.
    width: calc(100% - 5rem);
    margin-inline: auto;
    padding-top: 10rem;
    padding-bottom: 20rem;
    // Keeps the footer off the fold if the page is ever short (the empty page
    // header above is 10rem tall); inert once the content runs longer.
    min-height: calc(100vh - 10rem);
    min-height: calc(100svh - 10rem);
    // Anchors .cat.
    position: relative;
  }

  // One in each empty corner the two 48%-wide groups leave behind.
  .cat {
    position: absolute;
    width: clamp(8rem, 12.5vw, 12rem);
    height: auto;
    // Clicking it bursts the piñata's confetti (see @/scripts/confetti).
    cursor: pointer;
    transition: transform 150ms ease;

    &.is-popping {
      transform: scale(0.88);
    }
  }

  // Upper-right gap between the services index and the corner nav.
  .cat--top {
    top: 0;
    right: 6%;
  }

  // Mirror: the empty lower-left space beside and below the programs group.
  // Runs larger than the top one — there's more empty room down here.
  // Flush with main's bottom edge, so the only gap to the footer is the
  // shared one BaseLayout puts on .page-content.
  .cat--bottom {
    bottom: 0;
    left: 6%;
    width: clamp(13rem, 20vw, 19rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .cat {
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    // The page header above shrinks here and there's no side nav — content
    // can sit much closer to the top.
    main {
      padding-top: 2rem;
      // The tall padding below only existed to house the absolute .cat; it
      // sits in the flow here, so the shared .page-content gap is enough.
      padding-bottom: 0;
    }

    // In the flow now, one under each group. Sized and edge-pinned like
    // ImageText's mobile images rather than small and centred.
    .cat {
      position: static;
      display: block;
      width: min(32vw, 11rem);
      // Flush left, under the services list.
      margin: 2.5rem 0 0;
    }

    // Mirrors .programs' right-aligned text, and stays the larger of the two.
    .cat--bottom {
      width: min(48vw, 17rem);
      margin-left: auto;
    }
  }

  .pillars {
    display: flex;
    flex-direction: column;
    // A quiet index doesn't need the full line length; nudged off the left
    // gutter toward the center of the available space.
    width: 55%;
    margin-left: 10%;
  }

  @media (max-width: 1024px) {
    .pillars {
      width: 100%;
      margin-left: 0;
    }
  }

  // The mirror of .pillars: same width, anchored to the right edge instead,
  // with everything inside reading flush right.
  .programs {
    display: flex;
    flex-direction: column;
    width: 48%;
    margin-left: auto;
    margin-right: 10%;
    // Enough air that the two groups read as separate sections.
    margin-top: 5rem;
    text-align: right;
  }

  // The section header naming each group. A real <h2>, so type comes from the
  // base rule; alignment is inherited from the group (left in .pillars, right
  // in .programs) — that mirroring is what makes the two columns read.
  .group-label {
    color: var(--green);
    margin: 0 0 1.5rem;
  }

  .programs-intro {
    color: var(--black);
    margin: 0 0 2rem;
  }

  @media (max-width: 1024px) {
    .programs {
      width: 100%;
      margin-right: 0;
      margin-top: 6rem;
    }
  }
</style>
