---
// Temporary under-construction cover for candura.studio.
// The full site lives in the `_`-prefixed pages (excluded from routing) and
// is being rebuilt on a separate branch.
const title = 'Candura';
const description = 'Candura — under construction';
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imgSrc = new URL('imagen_OG.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={pageUrl} />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lda1qyz.css" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imgSrc} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <main class="cover">
      <img class="logo" src={`${import.meta.env.BASE_URL}greenlogo.svg`} alt="Candura" width="1301" height="330" />
      <div class="status">
        <img class="helmet" src={`${import.meta.env.BASE_URL}helmet.webp`} alt="" width="464" height="350" />
        <p>(under construction)</p>
      </div>
    </main>
  </body>
</html>

<style lang="scss">
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
  }

  .cover {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 3rem 1.5rem;
    box-sizing: border-box;
    background: #ffffff;
    text-align: center;
  }

  // Helmet + caption sit dead center of the viewport; the logo rides above it.
  .status {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .logo {
    position: absolute;
    left: 50%;
    bottom: calc(50% + clamp(4rem, 12vh, 9rem));
    transform: translateX(-50%);
    width: clamp(8.75rem, 30vw, 12.75rem);
    height: auto;
  }

  .helmet {
    width: clamp(3.5rem, 7vw, 4.25rem);
    height: auto;
  }

  .status p {
    margin: 0;
    font-family: 'neue-haas-grotesk-text', sans-serif;
    font-weight: 700;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    letter-spacing: -0.01em;
    color: #0a0a0a;
  }
</style>
