---
interface Props {
  heading: string;
  tagline: string;
  paragraphs: string[];
}

const { heading, tagline, paragraphs } = Astro.props;
---

<section class="text-block">
  <h2>{heading}</h2>
  <p class="tagline">{tagline}</p>
  <div class="body">
    {paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
  </div>
</section>

<style lang="scss">
  .text-block {
    // Narrower than ImageText's .about-split and centred in the same column
    // (.page-content already excludes the corner nav's --nav-width).
    width: calc(100% - 20rem);
    max-width: 55rem;
    margin: 3rem auto 4rem;

    h2 {
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      // A step below ImageText's h2 — this block leads with its body copy.
      font-size: clamp(1.5rem, 2.6vw, 2rem);
      line-height: 1.2;
      color: var(--green);
      margin: 0 0 0.5rem;
    }

    .tagline {
      font-family: var(--font-body);
      font-weight: var(--font-weight-body);
      font-size: 1.4rem;
      line-height: 1.4;
      color: var(--black);
      margin: 0 0 2rem;
    }

    .body p {
      font-family: var(--font-body);
      font-weight: var(--font-weight-body);
      // Matches ImageText's p.
      font-size: 1.2rem;
      line-height: 1.75;
      color: var(--black);
      text-align: justify;
      margin: 0 0 1.25rem;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  // The nav column is gone here, so fall back to the narrower gutters
  // ImageText uses at the same breakpoint.
  @media (max-width: 1024px) {
    .text-block {
      width: calc(100% - 5rem);
    }
  }

  @media (max-width: 500px) {
    .text-block {
      .tagline {
        font-size: 1.15rem;
      }

      .body p {
        font-size: 1rem;
      }
    }
  }
</style>
