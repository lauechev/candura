---
import Heading from '@/components/Heading.astro';

interface Props {
  heading: string;
  tagline: string;
  paragraphs: string[];
}

const { heading, tagline, paragraphs } = Astro.props;
---

<section class="text-block">
  <div class="heading-wrap"><Heading>{heading}</Heading></div>
  <div class="body">
    {paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
  </div>
  <p class="tagline">{tagline}</p>
</section>

<style lang="scss">
  .text-block {
    // Narrower than ImageText's .about-split and centred in the same column
    // (.page-content already excludes the corner nav's --nav-width).
    width: calc(100% - 34rem);
    max-width: 55rem;
    margin: 2rem auto 3rem;

    .heading-wrap {
      margin-bottom: 4rem;
    }

    .tagline {
      font-family: var(--font-body);
      font-weight: var(--font-weight-body);
      font-size: 1.4rem;
      line-height: 1.4;
      color: var(--black);
      text-align: center;
      margin: 2rem 0 0;
    }

    .body p {
      font-family: var(--font-body);
      font-weight: var(--font-weight-body);
      // Matches ImageText's p.
      font-size: 1.2rem;
      line-height: 1.75;
      color: var(--black);
      text-align: justify;
      margin: 0 0 1.25rem;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  // The nav column is gone here, so fall back to the narrower gutters
  // ImageText uses at the same breakpoint.
  @media (max-width: 1024px) {
    .text-block {
      width: calc(100% - 5rem);
    }
  }

  @media (max-width: 500px) {
    .text-block {
      .tagline {
        font-size: 1.15rem;
      }

      .body p {
        font-size: 1rem;
      }
    }
  }
</style>
