---
import type { Profile } from '@/data/about';

interface Props {
  // Unset for now — nothing renders until a title is decided on.
  title?: string;
  columns: Profile[];
}

const { title, columns } = Astro.props;
---

<section class="profiles">
  {title && <h2 class="profiles-title">{title}</h2>}
  <div class="profiles-grid">
    {
      columns.map((column: Profile) => (
        <article class="profile">
          {/* First in source order: the portrait heads its column, centred. */}
          <img class="profile-image" src={column.image} alt={column.imageAlt} loading="lazy" decoding="async" />
          <h3 class="profile-name">({column.name})</h3>
          <p class="profile-tagline">{column.tagline}</p>
          {column.paragraphs.map((paragraph: string) => (
            <p class="profile-body">{paragraph}</p>
          ))}
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  .profiles {
    // Narrow measure, matching TextBlock above it rather than the full-width
    // .about-split blocks below. The generous top margin sets this section
    // apart from TextBlock.
    width: calc(100% - 20rem + 15px);
    max-width: calc(55rem + 15px);
    margin: 8rem auto 4rem;
  }

  .profiles-title {
    font-family: var(--font-display);
    font-weight: var(--font-weight-body);
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    line-height: 1.2;
    color: var(--black);
    margin: 0 0 2rem;
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem;
  }

  .profile {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .profile-name {
    font-family: var(--font-display);
    font-weight: var(--font-weight-body);
    // A step down from a full-width section heading — these sit in half-width
    // columns.
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.2;
    color: var(--black);
    text-transform: lowercase;
    margin: 0 0 0.5rem;
  }

  // Mirrors TextBlock's .tagline: a lead-in line under the name.
  .profile-tagline {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
    font-size: 1.4rem;
    line-height: 1.4;
    color: var(--black);
    margin: 0 0 1.5rem;
  }

  .profile-body {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
    // = ImageText's p and TextBlock's .body p.
    font-size: 1.2rem;
    line-height: 1.75;
    color: var(--black);
    text-align: justify;
    margin: 0 0 1.25rem;
  }

  .profile-image {
    width: 100%;
    // A small portrait, not a column-wide card.
    max-width: 11rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
    // Centred over the text it heads.
    margin: 0 auto 4.5rem;
  }

  // The nav column is gone here; match the narrower gutters ImageText uses.
  @media (max-width: 1024px) {
    .profiles {
      width: calc(100% - 5rem);
    }
  }

  @media (max-width: 768px) {
    .profiles-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 500px) {
    .profile-tagline {
      font-size: 1.15rem;
    }

    .profile-body {
      font-size: 1rem;
    }
  }
</style>
