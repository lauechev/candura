---
interface Props {
  title: string;
  items: string[];
  // 'right' mirrors the row: title flush right, toggle on the left, and the
  // hover nudge reversed. Used by the programs group on the services page.
  align?: 'left' | 'right';
}

const { title, items, align = 'left' } = Astro.props;
---

<div class:list={['service-pillar', { 'is-right': align === 'right' }]}>
  <button class="service-banner" aria-expanded="false">
    <span class="banner-title">{title}</span>
    <svg
      class="banner-chevron"
      aria-hidden="true"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <line x1="10" y1="2" x2="10" y2="18" stroke="var(--black)" stroke-width="3.5" stroke-linecap="round"></line>
      <line x1="2" y1="10" x2="18" y2="10" stroke="var(--black)" stroke-width="3.5" stroke-linecap="round"></line>
    </svg>
  </button>
  <div class="service-content">
    <ul class="service-items">
      {items.map((item: string) => <li>{item}</li>)}
    </ul>
  </div>
</div>

<script>
  const pillars = document.querySelectorAll<HTMLElement>('.service-pillar');

  pillars.forEach((pillar) => {
    const btn = pillar.querySelector<HTMLButtonElement>('.service-banner')!;
    const content = pillar.querySelector<HTMLElement>('.service-content')!;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all other pillars
      pillars.forEach((other) => {
        if (other === pillar) return;
        const otherBtn = other.querySelector<HTMLButtonElement>('.service-banner')!;
        const otherContent = other.querySelector<HTMLElement>('.service-content')!;
        otherBtn.setAttribute('aria-expanded', 'false');
        otherContent.style.height = '0';
      });

      // Toggle this pillar
      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        content.style.height = '0';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        content.style.height = content.scrollHeight + 'px';
      }
    });
  });
</script>

<style lang="scss">
  .service-pillar {
    // Needed by the height animation on .service-content.
    overflow: hidden;
  }

  .service-banner {
    width: 100%;
    background: none;
    color: var(--black);
    border: none;
    cursor: pointer;
    padding: 1.1rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: var(--font-weight-body);
    letter-spacing: -0.02em;
    text-align: left;
  }

  // Mirror of .nav-link in Nav.astro: same 200ms ease and 6px nudge, but
  // nudging rightward (nav goes left) and in green. Color snaps, as there.
  .banner-title {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .service-banner:hover .banner-title,
  .service-banner:focus-visible .banner-title,
  .service-banner[aria-expanded='true'] .banner-title {
    color: var(--green);
    transform: translateX(6px);
  }

  .banner-chevron {
    width: 0.8rem;
    height: 0.8rem;
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform 350ms ease;

    .service-banner[aria-expanded='true'] & {
      transform: rotate(45deg);
    }
  }

  .service-content {
    height: 0;
    overflow: hidden;
    transition: height 350ms ease;
  }

  .service-items {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 2rem;
    // Items flow down the first column, then continue in the second.
    columns: 2;
    column-gap: 4rem;

    li {
      break-inside: avoid;
      font-family: var(--font-body);
      font-weight: var(--font-weight-body);
      font-size: 1.15rem;
      line-height: 1.4;
      color: var(--black);
      padding: 0.3rem 0;
    }
  }

  // ── Mirrored variant ──────────────────────────────────────────────────────
  // Everything flips: the toggle moves to the left of the row, the title sits
  // flush right, and the hover nudge points left instead of right.
  .is-right {
    .service-banner {
      flex-direction: row-reverse;
      text-align: right;
    }

    .banner-chevron {
      margin-left: 0;
      margin-right: 1rem;
    }

    .service-banner:hover .banner-title,
    .service-banner:focus-visible .banner-title,
    .service-banner[aria-expanded='true'] .banner-title {
      transform: translateX(-6px);
    }

    // rtl makes the two columns fill right-to-left, so reading order follows
    // the alignment; each item restores ltr so its own text renders normally.
    .service-items {
      direction: rtl;
      text-align: right;

      li {
        direction: ltr;
      }
    }
  }

  @media (max-width: 768px) {
    .service-items {
      columns: 1;
    }
  }

  // Phones: the open lists read as body copy, so match the about page's body
  // size exactly (TextBlock and ImageText both drop to 1rem at this width),
  // and bring the banner titles down with them.
  @media (max-width: 500px) {
    .service-banner {
      font-size: 1.15rem;
    }

    .service-items li {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-chevron,
    .banner-title,
    .service-content {
      transition: none;
    }
  }
</style>
