---
interface Props {
  color: string;
  title: string;
  // A single string renders one <p>; an array renders one <p> per entry.
  description: string | string[];
  image: string;
  // Optional list rendered after the paragraphs, e.g. the About page's
  // "who we work with" section.
  bullets?: string[];
  reverse?: boolean;
  imageSize?: string;
}

const { color, title, description, image, bullets, reverse = false, imageSize = '80%' } = Astro.props;

const paragraphs = (Array.isArray(description) ? description : [description]).filter(Boolean);
---

<div class:list={['about-split', { 'about-split--reverse': reverse }]}>
  <div class="split-text">
    <h2>{title}</h2>
    {paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
    {
      bullets && bullets.length > 0 && (
        <ul>
          {bullets.map((bullet: string) => (
            <li>{bullet}</li>
          ))}
        </ul>
      )
    }
    <slot />
  </div>
  <div class="split-image" style={`--square-color: ${color}`}>
    <img src={image} alt={title} style={`max-width: ${imageSize}; max-height: ${imageSize};`} />
  </div>
</div>

<style lang="scss">
  .about-split {
    display: grid;
    grid-template-columns: 1fr 50vh;
    grid-template-areas: 'text image';
    border-radius: 15px;
    overflow: hidden;
    // min-, not a fixed height: blocks with long copy (the bulleted "who we
    // work with") grow instead of being clipped by the overflow above.
    min-height: 50vh;
    // 100% of .page-content (already excludes the corner nav's --nav-width
    // column) minus 10rem of gutters.
    width: calc(100% - 10rem);
    margin: 0 auto 1rem;
  }

  .about-split--reverse {
    grid-template-columns: 60vh 1fr;
    grid-template-areas: 'image text';
  }

  .split-text {
    grid-area: text;
    padding: 3.5rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    .about-split--reverse & {
      border-right: none;
      text-align: right;
    }
  }

  .split-image {
    grid-area: image;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem;
    overflow: hidden;

    img {
      max-width: 80%;
      max-height: 80%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.8vw, 2.8rem);
    font-weight: 500;
    color: var(--black);
    margin: 0 0 1.25rem;
    letter-spacing: 0;
  }

  // Shared so list items can never drift from the body copy above them.
  p,
  li {
    font-family: var(--font-body);
    font-size: 1.2rem;
    line-height: 1.75;
    color: var(--black);
    // Flush on both edges, matching TextBlock and Profiles. Wins over the
    // text-align: right that .about-split--reverse sets on the container, so
    // only the heading follows the mirrored alignment.
    text-align: justify;
    margin: 0;
  }

  // Only bites when `description` is an array; single-string blocks render one
  // <p> and are unaffected.
  p + p {
    margin-top: 1.25rem;
  }

  // The project had no list style to reuse (Service.astro's is list-style:
  // none + columns: 2, a different thing), so this is the baseline.
  ul {
    list-style: disc;
    // Room for the marker; same 1.25rem rhythm as p + p above.
    padding-left: 1.25rem;
    margin: 1.25rem 0 0;
  }

  li + li {
    margin-top: 0.75rem;
  }

  // The reversed variant right-aligns .split-text; keeping the marker inside
  // the text flow stops it stranding on the far left of a right-aligned list.
  .about-split--reverse ul {
    list-style-position: inside;
    padding-left: 0;
  }

  /* ── Below 1500px ──────────────────────────────────────────────────── */
  @media (max-width: 1500px) {
    .about-split,
    .about-split--reverse {
      display: flex;
      flex-direction: column;
      height: auto;
    }

    .split-image {
      order: -1;
      height: 40vw;
      padding: 1.5rem;
      border-bottom: 2px solid var(--black);

      img {
        width: auto;
        max-width: 90%;
        max-height: 100%;
        height: 100%;
      }
    }

    .split-text,
    .about-split--reverse .split-text {
      order: 0;
      border-right: none;
      border-left: none;
      padding: 2.5rem;
      text-align: left;
    }

    h2 {
      font-size: clamp(1.8rem, 6vw, 3rem);
    }
  }

  @media (max-width: 1024px) {
    .about-split {
      // The nav column is gone here; match the intro card's 2.5rem gutters.
      // (The old 100vw - 25rem went negative on phones.)
      width: calc(100% - 5rem);
    }
  }

  /* ── Small mobile ────────────────────────────────────────────────────── */
  @media (max-width: 500px) {
    .split-image {
      height: 60vw;
    }

    .split-text {
      padding: 2rem 1.5rem;
      justify-content: flex-start;
    }

    h2 {
      font-size: 2.3rem;
      margin-bottom: 0.75rem;
      font-weight: 500;
    }

    p {
      font-size: 1rem;
    }

    img {
      width: auto;
      max-width: 90%;
      max-height: 100%;
      height: 100%;
    }
  }
</style>
