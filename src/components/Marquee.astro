---
// Full-width banner that scrolls its copy continuously. Reusable: the caller
// provides the phrase and colours (see HomeScreen.astro for the tagline use).
interface Props {
  text: string;
  label?: string;
  background?: string;
  color?: string;
}

const { text, label = text, background = 'var(--purple)', color = 'var(--cream)' } = Astro.props;

// Repeat the phrase so a single group comfortably exceeds the viewport width;
// the group is then duplicated and the track slides by exactly one group
// (-50%) for a seamless, gap-free loop.
const group = text.repeat(4);
---

<div class="marquee" aria-label={label} style={`--marquee-bg: ${background}; --marquee-fg: ${color}`}>
  <div class="marquee__track" aria-hidden="true">
    <span class="marquee__group">{group}</span>
    <span class="marquee__group">{group}</span>
  </div>
</div>

<style lang="scss">
  .marquee {
    width: 100%;
    overflow: hidden;
    padding-block: 0.15em;
    // Match the old tagline's type exactly.
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(0.7rem, 2.6vw, 1.5rem);
    line-height: 1.15;
    background: var(--marquee-bg);
    color: var(--marquee-fg);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    // -50% == one group width, since the track holds two identical groups.
    animation: marquee-scroll 100s linear infinite;
    will-change: transform;
  }

  .marquee__group {
    flex-shrink: 0;
    white-space: nowrap;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  // ── Small screens: the desktop clamp bottoms out at 0.7rem (~11px) on
  // phones — bump the floor and let it scale with the viewport ───────────────
  @media (max-width: 590px) {
    .marquee {
      font-size: clamp(1.05rem, 4.5vw, 1.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
