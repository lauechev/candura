---
// ── CENTERPIECE ─────────────────────────────────────────────────────────────
// A Three.js star piñata (see src/scripts/pinata.ts): hangs from a cord at the
// top of the hero, sways gently, and bursts palette confetti when clicked.
// The canvas fills the whole hero; the 3D camera (not CSS) frames the piñata.
import { getLangFromUrl, useTranslations } from '@/i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<div class="pinata-stage">
  <canvas id="pinata-canvas" role="img" aria-label={t('pinata.alt')}></canvas>
</div>

<script>
  import { Pinata, whenPaletteReady } from '@/scripts/pinata';

  const canvas = document.getElementById('pinata-canvas') as HTMLCanvasElement;

  // Colours come from CSS custom properties at construction; build before the
  // stylesheet applies and every surface comes out white.
  await whenPaletteReady();

  const pinata = new Pinata(canvas);
  pinata.start();

  window.addEventListener('pagehide', () => pinata.destroy());
</script>

<style lang="scss">
  // Full-hero overlay. Sits behind the marquee band (z 1) and the logo/nav,
  // but stays clickable so the piñata catches pointer events.
  .pinata-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
    // Only the piñata itself reacts (raycast), but the canvas must receive the
    // pointer events to test against.
    touch-action: manipulation;
  }
</style>
