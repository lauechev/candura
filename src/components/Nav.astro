---
import LanguageToggle from '@/components/LanguageToggle.astro';
import { getLangFromUrl, hasTranslation, localizePath, stripLang, useTranslations } from '@/i18n/ui';

const { pathname } = Astro.url;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Compare against the locale-stripped path so `/es/about` still marks "about".
const route = stripLang(pathname);

// Untranslated pages have no `/es/` version yet, so from a Spanish page those
// links fall back to the English route rather than 404ing. Once a page is
// translated, add it to `translatedRoutes` in @/i18n/ui and this picks it up.
const links = [
  { href: '/about', label: t('nav.about') },
  { href: '/services', label: t('nav.services') },
  { href: '/work', label: t('nav.work') },
  { href: '/contact', label: t('nav.contact') },
].map(({ href, label }) => ({
  href: hasTranslation(href) ? localizePath(href, lang) : href,
  label,
  isActive: route.startsWith(href),
}));
---

<nav class="corner-nav" id="corner-nav">
  <!-- Phones + tablets only: the links live behind this. -->
  <button
    class="hamburger"
    id="nav-toggle"
    aria-expanded="false"
    aria-controls="nav-menu"
    aria-label="Toggle navigation"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="nav-menu" id="nav-menu">
    <ul class="nav-links">
      {
        links.map(({ href, label, isActive }) => (
          <li>
            <a href={href} class:list={['nav-link', { 'is-active': isActive }]}>
              ({label})
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Fixed top-right on desktop; drops into the overlay below the links on
         phones and tablets. See LanguageToggle.astro. -->
    <LanguageToggle />
  </div>
</nav>

<script>
  const nav = document.getElementById('corner-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const footer = document.querySelector('footer');

  // ── Fullscreen menu (phones + tablets) ──────────────────────────────────────
  if (nav && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      // Stop the page scrolling behind the overlay.
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    // Close on navigation and on Escape.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // ── Footer collision ────────────────────────────────────────────────────────
  // The nav is fixed and the footer is near-black — purple links over it are
  // unreadable, so fade the nav out while the footer is on screen.
  if (nav && footer) {
    const observer = new IntersectionObserver(([entry]) => nav.classList.toggle('is-hidden', entry.isIntersecting), {
      threshold: 0,
    });
    observer.observe(footer);

    window.addEventListener('pagehide', () => observer.disconnect());
  }
</script>

<style lang="scss" is:global>
  // Set on <body> while the fullscreen menu is open.
  body.nav-open {
    overflow: hidden;
  }
</style>

<style lang="scss">
  .corner-nav {
    position: fixed;
    right: clamp(1.25rem, 3vw, 2.75rem);
    bottom: clamp(1.5rem, 6vh, 4rem);
    z-index: 100;

    // While the fullscreen menu is open it must cover the logo (z 90) and the
    // language toggle (z 100) too.
    &.is-open {
      z-index: 300;
    }
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: clamp(0.75rem, 2.5vh, 1.6rem);
    transition:
      opacity 250ms ease,
      visibility 250ms ease;
  }

  // Only the links fade over the footer — the language toggle is a child of
  // this nav too, and it must stay usable at the bottom of the page.
  .corner-nav.is-hidden .nav-links {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .nav-link {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.15rem, 1.9vw, 1.75rem);
    letter-spacing: -0.02em;
    color: var(--purple);
    text-decoration: none;
    opacity: 0.85;
    transition:
      transform 200ms ease,
      opacity 200ms ease,
      color 200ms ease;

    &:hover,
    &:focus-visible {
      opacity: 1;
      transform: translateX(-6px);
      color: var(--green);
    }

    &.is-active {
      opacity: 1;
      transform: translateX(-6px);
      color: var(--green);
    }
  }

  // Desktop only — the hamburger is a small-screen affordance.
  .hamburger {
    display: none;
  }

  // ── Phones + tablets: hamburger + fullscreen menu ───────────────────────────
  @media (max-width: 1024px) {
    // The hamburger takes the top-right corner the language toggle occupied on
    // desktop; the toggle itself moves inside the overlay.
    .corner-nav {
      top: clamp(1.25rem, 3vw, 2.5rem);
      right: clamp(1.25rem, 3vw, 2.75rem);
      bottom: auto;
    }

    // The footer fade exists to keep purple links legible over black. Up here
    // the nav no longer sits over the footer at all, so never hide it.
    .corner-nav.is-hidden .nav-links {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      // Comfortable tap target.
      width: 44px;
      height: 44px;
      padding: 0.25rem;
      margin-left: auto;
      background: none;
      border: none;
      cursor: pointer;
      // Sits above the overlay so it doubles as the close button.
      position: relative;
      z-index: 2;

      span {
        display: block;
        width: 28px;
        height: 4px;
        border-radius: 2px;
        margin: 0 auto;
        transition:
          transform 200ms ease,
          opacity 200ms ease;
      }

      span:nth-child(1) {
        background: var(--red);
      }
      span:nth-child(2) {
        background: var(--pink);
      }
      span:nth-child(3) {
        background: var(--orange);
      }
    }

    // Burger → X. Offset matches bar height (4px) + gap (6px).
    .is-open .hamburger {
      span:nth-child(1) {
        transform: translateY(10px) rotate(45deg);
      }
      span:nth-child(2) {
        opacity: 0;
      }
      span:nth-child(3) {
        transform: translateY(-10px) rotate(-45deg);
      }
    }

    // Fullscreen overlay: covers the entire viewport, closed by default.
    .nav-menu {
      position: fixed;
      inset: 0;
      z-index: 1;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: clamp(1.5rem, 5vh, 3rem);
      margin: 0;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 250ms ease,
        visibility 250ms ease;
    }

    .is-open .nav-menu {
      opacity: 1;
      visibility: visible;
    }

    .nav-links {
      align-items: center;
      gap: clamp(1.5rem, 5vh, 3rem);
    }

    .nav-link {
      font-size: clamp(1.75rem, 6vw, 2.75rem);
      // Comfortable tap target without changing the visual size.
      padding: 0.4rem 1rem;
      opacity: 1;

      &:hover,
      &:focus-visible,
      &.is-active {
        // Sliding sideways makes no sense in a centered stack.
        transform: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links,
    .nav-link,
    .nav-menu,
    .hamburger span {
      transition: none;
    }

    .nav-link:hover,
    .nav-link:focus-visible {
      transform: none;
    }
  }
</style>
