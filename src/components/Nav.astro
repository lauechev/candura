---
import LanguageToggle from '@/components/LanguageToggle.astro';
import { getLangFromUrl, hasTranslation, localizePath, stripLang, useTranslations } from '@/i18n/ui';

const { pathname } = Astro.url;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Compare against the locale-stripped path so `/es/about` still marks "about".
const route = stripLang(pathname);

// Untranslated pages have no `/es/` version yet, so from a Spanish page those
// links fall back to the English route rather than 404ing. Once a page is
// translated, add it to `translatedRoutes` in @/i18n/ui and this picks it up.
const links = [
  { href: '/about', label: t('nav.about') },
  { href: '/services', label: t('nav.services') },
  { href: '/work', label: t('nav.work') },
  { href: '/contact', label: t('nav.contact') },
].map(({ href, label }) => ({
  href: hasTranslation(href) ? localizePath(href, lang) : href,
  label,
  isActive: route.startsWith(href),
}));
---

<nav class="corner-nav" id="corner-nav">
  <!-- Phones + tablets only: the links live behind this. -->
  <button
    class="hamburger"
    id="nav-toggle"
    aria-expanded="false"
    aria-controls="nav-menu"
    aria-label="Toggle navigation"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="nav-menu" id="nav-menu">
    <!-- Desktop only: purely decorative balloons that "hold up" the panel. -->
    <div class="balloons" aria-hidden="true">
      <!-- <img class="balloon balloon--green" src={`${import.meta.env.BASE_URL}ballon-pink.png`} alt="" />
      <img class="balloon balloon--pink" src={`${import.meta.env.BASE_URL}ballon-pink.png`} alt="" />
      <img class="balloon balloon--yellow" src={`${import.meta.env.BASE_URL}ballon-pink.png`} alt="" /> -->
    </div>

    <ul class="nav-links">
      {
        links.map(({ href, label, isActive }) => (
          <li>
            <a href={href} class:list={['nav-link', { 'is-active': isActive }]}>
              ({label})
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Fixed top-right on desktop; drops into the overlay below the links on
         phones and tablets. See LanguageToggle.astro. -->
    <LanguageToggle />
  </div>
</nav>

<script>
  const nav = document.getElementById('corner-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  // ── Fullscreen menu (phones + tablets) ──────────────────────────────────────
  if (nav && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
      // Stop the page scrolling behind the overlay.
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    // Close on navigation and on Escape.
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style lang="scss" is:global>
  // Set on <body> while the fullscreen menu is open.
  body.nav-open {
    overflow: hidden;
  }
</style>

<style lang="scss">
  .corner-nav {
    position: fixed;
    right: clamp(1.25rem, 3vw, 2.75rem);
    // Vertically centered via auto margins, nudged a touch above dead-center.
    // NOTE: don't use `transform` here — a transformed ancestor becomes the
    // containing block for the fixed-position LanguageToggle child, which would
    // drag it inside the panel instead of the viewport corner.
    top: 0;
    bottom: -20vh;
    height: fit-content;
    margin-block: auto;
    z-index: 100;

    // While the fullscreen menu is open it must cover the logo (z 90) and the
    // language toggle (z 100) too.
    &.is-open {
      z-index: 300;
    }
  }

  // ── Desktop: the green panel the balloons float above ───────────────────────
  .nav-menu {
    position: relative;
    // background: var(--green);
    border-radius: 15px;
    padding: clamp(1.25rem, 3vh, 1.75rem) clamp(1.25rem, 2.2vw, 1.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: clamp(0.75rem, 2.5vh, 1.4rem);
  }

  .nav-link {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    letter-spacing: -0.02em;
    // White on the green panel, always — no color change on any state.
    color: var(--purple);
    text-decoration: none;
    opacity: 1;
    transition:
      transform 200ms ease,
      opacity 200ms ease;

    &:hover,
    &:focus-visible,
    &.is-active {
      opacity: 1;
      color: var(--orange);
      transform: translateX(-6px);
    }
  }

  // ── Balloons: bottoms fixed to the panel's top edge; they rock side to side ─
  .balloons {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    // Overlap the panel top so the empty transparent area at the bottom of the
    // PNGs tucks behind the nav and the strings read as "attached" to it.
    bottom: calc(100% - 1.8rem);
    display: flex;
    align-items: flex-end; // aligns all string ends on one line
    justify-content: center;
    pointer-events: none;
  }

  .balloon {
    width: clamp(4rem, 6vw, 5.25rem);
    height: auto;
    transform-origin: bottom center; // pivot at the attached string end
    filter: drop-shadow(0 8px 10px rgba(10, 10, 10, 0.22));
    animation: balloon-sway 6.5s ease-in-out infinite;
    will-change: transform;
  }

  // Left → right: green, pink (on top), yellow — overlapping slightly via the
  // negative margins. Each rocks on its own timing so they don't move in unison.
  .balloon--green {
    z-index: 1;
    margin-right: -2.4rem;
    // Nudge up to sit level with the pink/yellow — the green PNG has less empty
    // space below its string.
    margin-bottom: 0.1rem;
    animation-duration: 7s;
  }

  .balloon--pink {
    z-index: 3;
    animation-duration: 6s;
    animation-delay: -1.2s;
  }

  .balloon--yellow {
    z-index: 2;
    margin-left: -2.4rem;
    animation-duration: 7.6s;
    animation-delay: -0.6s;
  }

  @keyframes balloon-sway {
    0%,
    100% {
      transform: rotate(-2deg);
    }
    50% {
      transform: rotate(2deg);
    }
  }

  // Desktop only — the hamburger is a small-screen affordance.
  .hamburger {
    display: none;
  }

  // ── Phones + tablets: hamburger + fullscreen menu ───────────────────────────
  @media (max-width: 1024px) {
    // The hamburger takes the top-right corner the language toggle occupied on
    // desktop; the toggle itself moves inside the overlay.
    .corner-nav {
      top: clamp(1.25rem, 3vw, 2.5rem);
      right: clamp(1.25rem, 3vw, 2.75rem);
      bottom: auto;
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      // Comfortable tap target.
      width: 44px;
      height: 44px;
      padding: 0.25rem;
      margin-left: auto;
      background: none;
      border: none;
      cursor: pointer;
      // Sits above the overlay so it doubles as the close button.
      position: relative;
      z-index: 2;

      span {
        display: block;
        width: 28px;
        height: 4px;
        border-radius: 2px;
        margin: 0 auto;
        transition:
          transform 200ms ease,
          opacity 200ms ease;
      }

      span:nth-child(1) {
        background: var(--red);
      }
      span:nth-child(2) {
        background: var(--pink);
      }
      span:nth-child(3) {
        background: var(--orange);
      }
    }

    // Burger → X. Offset matches bar height (4px) + gap (6px).
    .is-open .hamburger {
      span:nth-child(1) {
        transform: translateY(10px) rotate(45deg);
      }
      span:nth-child(2) {
        opacity: 0;
      }
      span:nth-child(3) {
        transform: translateY(-10px) rotate(-45deg);
      }
    }

    // Fullscreen overlay: covers the entire viewport, closed by default.
    .nav-menu {
      position: fixed;
      inset: 0;
      z-index: 1;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: clamp(1.5rem, 5vh, 3rem);
      margin: 0;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 250ms ease,
        visibility 250ms ease;
    }

    .is-open .nav-menu {
      opacity: 1;
      visibility: visible;
    }

    .nav-links {
      align-items: center;
      gap: clamp(1.5rem, 5vh, 3rem);
    }

    .nav-link {
      font-size: clamp(1.75rem, 6vw, 2.75rem);
      // Comfortable tap target without changing the visual size.
      padding: 0.4rem 1rem;
      opacity: 1;

      &:hover,
      &:focus-visible,
      &.is-active {
        // Sliding sideways makes no sense in a centered stack.
        transform: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links,
    .nav-link,
    .nav-menu,
    .hamburger span {
      transition: none;
    }

    .nav-link:hover,
    .nav-link:focus-visible {
      transform: none;
    }
  }
</style>
