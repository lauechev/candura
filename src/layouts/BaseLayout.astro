---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Divider2 from '@/components/Divider2.astro';
import Brand from '@/components/Brand.astro';
import { getLangFromUrl, stripLang } from '@/i18n/ui';

interface Props {
  title?: string;
  pageHeading?: string;
  description?: string;
  image?: { src: string; alt: string };
}

const { title, pageHeading, description, image } = Astro.props;

const projectName = 'Candura';
const defaultDescription = 'Candura';
const { pathname } = Astro.url;
const lang = getLangFromUrl(Astro.url);
const isHome = (stripLang(pathname).replace(/\/$/, '') || '/') === '/';
const seoTitle = title || projectName;
const seoDescription = description || defaultDescription;
const baseUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const pageUrl = new URL(pathname, Astro.site);
const imgSrc = image ? new URL(image.src, baseUrl) : new URL('imagen_OG.png', baseUrl);
const imgAlt = image ? image.alt : projectName;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} sizes="32x32" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/png" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={pageUrl} />
    <link rel="stylesheet" href="https://use.typekit.net/lda1qyz.css" />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <!-- OpenGraph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={projectName} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={imgSrc} />
    <meta property="og:image:alt" content={imgAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={imgSrc} />
    <meta name="twitter:image:alt" content={imgAlt} />
  </head>

  <!-- --brand-h: the corner logo's rendered height — its width clamp (mirrored
       from Brand.astro, per variant) × the SVG aspect (330/1301). Lets the
       hamburger in Nav.astro center-align on the logo. -->
  <body style={`--brand-h: calc(${isHome ? 'clamp(9rem, 18vw, 15rem)' : 'clamp(5.5rem, 9vw, 7.5rem)'} * 0.2537)`}>
    <Brand variant={isHome ? 'home' : 'compact'} />
    <!-- Nav renders the language toggle: on desktop it's fixed top-right, on
         smaller screens it lives inside the fullscreen menu. -->
    <Nav />
    <div class:list={['page-content', { 'with-side-nav': !isHome }]}>
      {pageHeading && <div class="page-header-global" />}
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style lang="scss" is:global>
  @use '@/styles/styles.scss';

  body {
    background: var(--cream);
    // Anchors the absolutely-positioned Brand in the top-left corner.
    position: relative;
    // Footer sits at the viewport bottom even on short pages: the content
    // column grows to fill the gap. svh keeps mobile URL bars from causing
    // overflow; vh is the fallback for browsers without svh.
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .page-content {
    flex: 1 0 auto;
  }

  // Non-home pages: reserve the right-hand column the fixed corner nav
  // occupies so page content sits entirely to its left. --nav-width
  // (styles.scss) is 0rem below 1025px, where the nav becomes a hamburger
  // overlay, so this collapses on its own there.
  .page-content.with-side-nav {
    padding-right: var(--nav-width);
  }

  .page-header-global {
    // The old fixed top nav bar is gone; this now clears the compact logo.
    padding: 7rem 5vw 3rem;
  }

  .page-title {
    font-family: var(--font-logo) !important;
    font-size: clamp(4.5rem, 8vw, 6rem) !important;
    font-weight: 400 !important;
    color: var(--black);
    margin: 0 0 0.1em !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
  }

  @media (max-width: 1024px) {
    .page-header-global {
      padding-top: 6rem;
    }
  }

  @media (max-width: 500px) {
    .page-header-global {
      padding-top: 5.5rem;
    }
  }

  .page-rule {
    height: 3px;
    width: clamp(8rem, 18vw, 10rem);
    background: linear-gradient(
      to right,
      var(--blue) 0%,
      var(--blue) 14.28%,
      var(--purple) 14.28%,
      var(--purple) 28.57%,
      var(--yellow) 28.57%,
      var(--yellow) 42.85%,
      var(--red) 42.85%,
      var(--red) 57.14%,
      var(--pink) 57.14%,
      var(--pink) 71.42%,
      var(--orange) 71.42%,
      var(--orange) 85.71%,
      var(--green) 85.71%,
      var(--green) 100%
    );
  }
</style>
